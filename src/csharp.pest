single_line_comment = _{ "//" ~ (!NEWLINE ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
COMMENT = _{ single_line_comment | block_comment }
line_continuation = { "`" ~ NEWLINE }
WHITESPACE     = _{ " " | "\t" | line_continuation | NEWLINE }
BREAK = _{ " " | "\t" }

program = { SOI ~ program_content ~ EOI }
program_content = { nesting_guard ~ (namespace_statement | class_statement | using_statement | enum_statement | function_declaration)* ~ DROP }

// Each guarded rule pushes one entry on the pest stack, so deeply nested input
// fails to parse instead of overflowing the native stack.
nesting_guard = _{ !PEEK[256..] ~ PUSH("") }
namespace_statement = { "namespace" ~ var_name ~ (";" | statement_body) }
statement_body = _{ "{" ~ program_content ~ "}" ~ ";"? }
using_statement = { "using" ~  member_chain ~ ";"* }

static_attribute = { "static" }
const_attribute = { "const" }
extern_attribute = { "extern" }
readonly_attribute = { "readonly" }
field_hidden = { "new" }
field_attribute = {attribute_list? ~ access_modifier? ~ (field_hidden | static_attribute | const_attribute | readonly_attribute | extern_attribute)* }
new_expression = { "new" ~ (list_initialization | constructor )}
list_initialization = { type_literal? ~ (initializer_list | curly_arg_list | bracket_arg_list) }
constructor = {type_literal ~ parenthesis_arg_list? ~ initializer_list?}

assignment_exp = { variable_access ~ modify_and_assign_op ~ expression }
enum_assign_exp = { variable ~  "=" ~ expression }
field_initialization = { field_attribute ~ type_literal ~ variable ~  "=" ~ expression  }
field_declaration = { field_attribute ~ type_literal ~ variable }
code_line = { (assignment_exp | field_initialization | field_declaration | expression_access | expression) ~ ";" }

//---------------------------------- BLOCKS
parameter_list = { fn_parameter ~ ("," ~ fn_parameter)* }
fn_parameter = { attribute_list? ~ "ref"? ~ "out"? ~ type_literal ~ variable ~ fn_parameter_default? }
fn_parameter_default = { "=" ~ primary_expression }

named_blocks = { named_block+ }
named_block = { block_name ~ statement_block }
block_name = { ^"dynamicparam" | ^"begin" | ^"process" | ^"end" }
statement_block = { "{" ~ statements ~ "}" }
statements = { statement* }

//------------------------------------- STATEMENTS
statement = _{ nesting_guard ~ (
	if_statement 
    | labeled_statement
    | flow_control_statement
    | function_statement 
    | function_declaration
    | class_statement
    | enum_statement
    | try_statement
    | code_line
    | statement_terminator
) ~ DROP }
statement_terminator = { ";"+ }

if_statement = {
    ^"if" ~ "(" ~ expression ~ ")"  ~ (statement_block | statements) ~ elseif_clauses? ~ else_condition?
}
elseif_clauses = {else_if+}
else_if = { ^"elseif" ~ "(" ~ expression ~ ")" ~  (statement_block | statements) }
else_condition = { ^"else" ~  (statement_block | statements) }

//------------------------------- LABELED STATEMENTS
label = @{ ":" ~ ASCII_ALPHANUMERIC* }
labeled_statement = { label? ~ (
    switch_statement 
    | foreach_statement 
    | for_statement 
    | while_statement 
    | do_statement
) }
label_exp = { label | unary_exp }

switch_statement = { ^"switch" ~ switch_condition ~ switch_body }
switch_condition = { "(" ~ expression ~ ")" }
switch_body = { "{" ~ switch_clause* ~ "}" }
switch_clause = { switch_clause_condition ~ ":" ~ (!"break" ~ (statement))* ~ "break;"? }
switch_clause_condition = { "case" ~ primary_expression }


foreach_statement = { foreach_header ~ statement_block }
foreach_header = { "foreach" ~ "(" ~ type_literal? ~ variable ~ "in" ~ expression ~ ")"}
foreach_parameter = { ^"-parallel" }

while_statement = { while_header ~ statement_block }
while_header = { "while" ~ "(" ~ expression ~ ")" }

do_statement = { ^"do" ~ statement_block ~ ( ^"while" | ^"until" ) ~ "(" ~ expression ~ ")"}

for_statement = { for_header ~ statement_block }
for_header = {"for" ~ "(" ~ for_initializer_block? ~ ")" }
for_initializer_block = {
    for_initializer? ~ statement_terminator ~
    for_condition?   ~ statement_terminator ~
    for_iterator?    ~ statement_terminator?
}
for_initializer = { field_initialization | assignment_exp | expression }
for_condition   = { expression }
for_iterator    = { expression }

//---------------------------------- OTHER STATEMENTS
return_type = _{type_literal}
function_statement = { function_header ~ statement_block }
function_declaration = { function_header ~ ";" }
function_header = { function_header_prefix ~ return_type ~ function_name ~ function_parameter_declaration }
function_name = @{ generic_token }
function_parameter_declaration = _{ "(" ~ parameter_list? ~ ")" }

flow_control_statement = {
    flow_control_label_statement
  | flow_control_expression_statement
}
flow_control_label_statement = _{ break_statement | continue_statement }
break_statement = { "break" ~ label_exp? }
continue_statement = { "continue" ~ label_exp? }

flow_control_expression_statement = { throw_statement | return_statement | exit_statement }
throw_statement = { "throw" ~ expression?}
return_statement = { "return" ~ expression?}
exit_statement = { "exit" ~ expression?}

//--------------------------------- TRY CATCH
try_statement = { "try" ~ statement_block ~ (catch_clauses ~ finally_clause? | finally_clause?) }
catch_clauses = { catch_clause+ }
catch_clause = { "catch" ~ catch_type_list? ~ statement_block }
catch_type_list = { "(" ~ field_declaration ~ ")" }
finally_clause = { "finally" ~ statement_block }

//--------------------------------- CLASS STATEMENTS
function_attribute = { "delegate" | "static" | "hidden" | "virtual" | "override" | "extern" | "readonly" }
function_attributes = { function_attribute+ }
function_header_prefix = {
    attribute_list? ~
    access_modifier? ~
    function_attributes? 
}

inheritance = { ":" ~ simple_name ~ ("," ~ simple_name)* }

class_statement = {
   function_header_prefix ~ 
   ("class" | "struct") ~ simple_name ~ inheritance? ~ (statement_terminator | class_body)
}
class_body = { 
    "{" ~ nesting_guard
   ~ (function_statement | function_declaration | class_statement | enum_statement | ((field_initialization | field_declaration ) ~ ";"))*
   ~ DROP ~ "}" ~ ";"? 
   }

access_modifier = { "new"? ~ ("public" | "private" | "protected" | "internal") }
// -----------------------ENUM
enum_statement = { function_header_prefix  ~ "enum" ~ simple_name ~ inheritance? ~ (statement_terminator | enum_body) }
enum_body = { "{" ~ enum_assign_exp ~ ("," ~ enum_assign_exp)* ~ "}" ~ ";"? }
enum_member = { simple_name ~ (("=" ~ decimal_integer) | ("=" ~ hex_integer) )? }

// ---------------------- EXPRESSION
expression = { nesting_guard ~ bitwise_exp ~ (logical_operator ~ bitwise_exp)* ~ DROP }
logical_operator = { "&&" | ^"||" }

bitwise_exp = { as_expression ~ (bitwise_operator ~ as_expression)* }
bitwise_operator = { "&" | "|" | "^" | "<<" | ">>" | ">>>" }

as_expression = {comparison_exp ~ (^"-as" ~ (cast_literal|comparison_exp))*}
// strange case. -split and -join can be invoke without previous expression, eg. "-join 'some'"
comparison_exp = {
    (additive_exp ~ (string_op ~ additive_exp)*) | 
    empty ~ ((join_op | split_op) ~ additive_exp)+ 
    }
empty = {""}

additive_exp = { multiplicative_exp ~ (WHITESPACE* ~ additive_op ~ WHITESPACE* ~ multiplicative_exp)* }
additive_op = _{ plus | minus }
plus = { "+" }
minus = {"-"}

multiplicative_exp = { format_exp ~ (WHITESPACE* ~ multiplicative_op ~ WHITESPACE* ~ format_exp)* }
multiplicative_op = _{ mul | divide | mod }
mul = { "*" }
divide = { "/" }
mod = { "%" }

format_exp = { range_exp ~ ( format_op  ~ range_exp)* }
format_op = _{ ^"-f" }

range_exp = { 
    unary_exp ~ (WHITESPACE* ~ ".." ~ WHITESPACE* ~ unary_exp)? }

// `(T)(...)` is a cast; also trying it as a call on `(T)` is exponential when parsing fails
unary_exp = { nesting_guard ~ (expression_with_unary_operator | !(cast_literal ~ "(") ~ primary_expression) ~ DROP }

negate_op = { "!" }
bitwise_negate_op = { "~" }
expression_with_unary_operator = {
    (negate_op ~ unary_exp)
    | (bitwise_negate_op ~ unary_exp)
    | pre_inc_expression
    | pre_dec_expression
    | cast_expression
}

pre_inc_expression = { "++" ~ variable }
pre_dec_expression = { "--" ~ variable }
cast_expression = { !WHITESPACE ~ cast_literal ~ unary_exp }

//------------------------------------PRIMARY EXPRESSION
primary_expression = {
    new_expression
    | post_inc_expression
    | post_dec_expression
    | value_access
}
post_inc_expression = { variable ~ "++" }
post_dec_expression = { variable ~ "--" }

value_access = { value ~ 
    (
        parenthesis_arg_list
        | method_invocation
        // `.name(` is always a method_invocation; retrying it as member + call is exponential
        | member_access ~ !"("
        | element_access
    )*
}
member_access = { "." ~ member_name }
member_name = {
    simple_name
}
element_access = { "[" ~ expression ~ "]" }
method_invocation = { member_access ~ parenthesis_arg_list }
parenthesis_arg_list = _{ "(" ~ argument_list? ~ ")" }
curly_arg_list = _{ "{" ~ argument_list? ~ "}" }
bracket_arg_list = _{ "[" ~ argument_list? ~ "]" }

// --------------- EXPRESSION
member_chain = @{ member_name ~ member_access*}
variable_access = { variable ~ 
    (
        member_access
        | element_access
    )*
}
expression_access = { variable ~ 
    (
        parenthesis_arg_list
        | method_invocation
        // `.name(` is always a method_invocation; retrying it as member + call is exponential
        | member_access ~ !"("
        | element_access
    )*
}
prefix_assign_op = { (additive_op | multiplicative_op) }
assign_op = { "=" }
modify_and_assign_op = {prefix_assign_op? ~ assign_op }

//-------------------------------------STRING OPERATORS
string_op = { replace_op | split_op | cmp_op | contain_op | join_op | type_check_op }
replace_op = { ^"-replace" | ^"-ireplace" | ^"-creplace" }
split_op = { ^"-split" | ^"-isplit" | ^"-csplit" }
join_op = { ^"-join" }
cmp_op = { 
    "==" | "!=" | ">" | ">=" | "<" | "<="
//    | ^"-match" | ^"-cmatch" | ^"-imatch" | ^"-notmatch" | ^"-cnotmatch" | ^"-inotmatch"
//    | ^"-like"| ^"-clike" | ^"-ilike" | ^"-notlike" | ^"-inotlike" | ^"-cnotlike" 
}
contain_op = { ^"-inotin" | ^"-notin" | ^"-inotin" | ^"-cnotin" | ^"-contains" | ^"-ccontains" | ^"-icontains" | ^"-notcontains" | ^"-inotcontains" | ^"-cnotcontains" | ^"-in" | ^"-iin" | ^"-cin" }
type_check_op = { "is not" | "is" }

simple_operator = _{ "-" | "+" | "*" | "/" | "%" }

value = {
    parenthesized_expression
    | hash_literal_expression 
    | literal 
    | predefined_variable
    | variable
}
parenthesized_expression = !{ "(" ~ expression ~ ")"}
sub_expression = !{ "{" ~ expression ~ "}" }

hash_literal_expression = { "@{" ~ hash_literal_body? ~ "}" }
hash_literal_body = _{ hash_entry* }
hash_entry = { key_expression ~ "=" ~ expression ~ ";"*}

list_entry = { key_expression ~ "=" ~ expression }
initializer_list = { "{" ~ list_entry ~ ("," ~ list_entry)* ~ "}" }

dictionary_string = { "[" ~ string_literal ~"]"}
key_expression = { simple_name | unary_exp | dictionary_string }

variable = { "ref"? ~ var_name }
true_literal = @{ "true" }
false_literal = @{ "false" }
null_literal = @{ "null" }
predefined_variable = { true_literal | false_literal | null_literal}

parenthesized_variable = { "(" ~ variable ~ ")" }

var_name = @{ identifier }

argument_list      = { arg ~ ("," ~ arg)* }
arg = _{ named_arg | simple_arg  }
simple_arg = { "out"? ~ expression }
named_arg = { var_name ~ ":" ~ expression }
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
qualified_ident = { identifier ~ ("." ~ identifier)* }

simple_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

//----------------------LITERAL
literal = _{
	number_literal
    | string_literal
    | char_literal
}

//--------------------STRING LITERAL
string_literal = {
    simple_string_literal // "elo"
  | verbatim_string_literal // @"elo "" "
  | interpolated_string_literal // $"Value is {x}"
  | in_verbatim_string_literal // $@"Value is {x}"
  | raw_string_literal // """ asdafd """
}

interpolated_string_literal = ${
	 "$\""  ~ in_string_content* ~ "\""
}

in_string_content = _{
      dq_escape
    | sub_expression
    | dq_text_chunk
    | dollar_escape
    | backtick_escape
    | WHITESPACE
}

dq_escape = @{ "\"\"" }
dollar_escape = @{ "$" ~ (backtick_escape | "\\" )? }
backtick_escape = @{ "`" ~ non_whitespace_char ? } // handle backtick+char like `n
non_whitespace_char  = { !WHITESPACE ~ ANY }
dq_text_chunk = { (!("$" | "\"" | "`" | "{") ~ ANY)+ }

verbatim_string_literal = _{
    "@\""  ~ verbatim_content ~ "\""
}
verbatim_content = @{verbatim_content_char*}
verbatim_content_char = @{ "\"\"" | ((!("\"" | "\r" | "\n") ~ ANY)+) | verbatim_text_newline }
verbatim_text_newline = {NEWLINE ~ !"'@"}

in_verbatim_string_literal = @{
    "$@\"" ~ in_verbatim_content* ~ "\""
}
in_verbatim_content = _{
    sub_expression
    | backtick_escape
    | dollar_escape
    | in_verbatim_text_chunk
}
in_verbatim_text_chunk = ${ "\"\"" | (!("\"" | "$" | "`" | "{" ) ~ ANY)+ }

raw_string_literal_token = _{"\"\"\""}
raw_string_literal = ${
    (raw_string_literal_token ~ NEWLINE) ~ raw_string_literal_content ~ (NEWLINE ~ raw_string_literal_token)
}
raw_string_literal_content = { (!(NEWLINE ~ raw_string_literal_token) ~ ANY)+ }
simple_string_literal = _{ "\"" ~ simple_string_content ~ "\"" }
simple_string_content = @{ ("\"\"" | (!"\"" ~ ANY)+)* }

//----------------------CHAR LITERAL
char_literal = @{ "'" ~ (!"'" ~ ANY) ~ "'" }

//----------------------NUMBER LITERAL
suffix = { ^"u" | ^"f" | ^"l" | ^"d" | ^"m" }
number_literal = { additive_op? ~ number ~ suffix* }

number = ${ float | hex_integer| binary_integer| decimal_integer }

decimal_integer = @{ ASCII_DIGIT ~ ("_" | ASCII_DIGIT)* ~ !"_" }
hex_int = @{ HEX_DIGIT ~ ("_" | HEX_DIGIT)* ~ !"_" }
bin_int = @{ BIN_DIGIT ~ ("_" | BIN_DIGIT)* ~ !"_" }
BIN_DIGIT = @{"0" | "1"}
hex_integer = { ^"0x" ~ hex_int}
binary_integer = { ^"0b" ~ bin_int }
float = {float_1 | float_2 | float_3}
float_1 = { ASCII_DIGIT+ ~ "." ~ !"." ~ ASCII_DIGIT* ~ float_mantis? }
float_2 = @{ "." ~ ASCII_DIGIT+ ~ float_mantis? }
float_3 = @{ ASCII_DIGIT+ ~ float_mantis }
float_mantis = {^"e" ~ ("+" | "-") ~ ASCII_DIGIT+}


//----------------------TYPE LITERAL
cast_literal = { "(" ~ type_literal ~ ")" }
type_name = @{ type_identifier ~ ("." ~ type_identifier)* }
type_identifier = @{ (ASCII_ALPHANUMERIC | "_")+ }
type_literal = ${ dimensions |
      (type_name ~ generic_type? ~ dimensions?)
}
dimensions = { dimension+ }
type_literals = { type_literal ~ (BREAK* ~ "," ~ BREAK* ~ type_literal)* }
generic_type = { "<" ~ nesting_guard ~ type_literals ~ DROP ~ ">" }
dimension = { "[" ~ decimal_integer? ~ "]" }

//-----------------------ATTRIBUTES
attribute_list       = { attribute+ }
attribute            = { "[" ~ attribute_name ~ ("(" ~ attribute_arguments? ~ ")")? ~ "]"}
attribute_name       = _{ member_chain }
attribute_arguments  = { attribute_argument ~ ("," ~ attribute_argument)* }
attribute_argument   = { (expression ~ ("=" ~ expression)?) }

//-----------------------GENERIC TOKEN
generic_token = @{ generic_token_start ~ generic_token_rest* }
generic_token_start = _{
    !( ";" | "(" | ")" | "$" | "\"" | "'" | "-" | "{" | "}" | "@" | "|" | "[" | "`" | WHITESPACE | NEWLINE ) ~ ANY
}
generic_token_rest = _{
    !(WHITESPACE | "(" | ")" | "}" | "|" | ";" | ",") ~ ANY
}